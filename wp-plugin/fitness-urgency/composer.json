{
    "name": "your-name/fitness-urgency",
    "description": "WordPress plugin — fitness program urgency countdown",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload-dev": {
        "classmap": ["includes/", "tests/"]
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "config": {
        "optimize-autoloader": true
    }
}
